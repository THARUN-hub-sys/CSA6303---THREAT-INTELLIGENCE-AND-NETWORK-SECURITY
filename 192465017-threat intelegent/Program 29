incident = input("Enter incident: ").lower()

if "ransomware" in incident:
    print("Isolate Affected Systems")

elif "account" in incident:
    print("Disable Compromised Account")

elif "data leak" in incident:
    print("Restrict Data Access")

elif "ddos" in incident:
    print("Enable Traffic Filtering")

else:
    print("Investigate and Preserve Evidence")
